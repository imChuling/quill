# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# generated demos/snapshots/libraries (keep directory placeholders, no large binaries)
assets/demos/*.wav
assets/demos/*.png
assets/demos/*.tplib
assets/snapshots/*.npz
assets/libraries/*.tplib
!assets/**/.gitkeep

# report build outputs
docs/report/*.pdf

# stage 3 golden-file regression baseline (for daily local comparison, binaries not committed)
eval/golden/*.npy

# OS
.DS_Store
assets/recordings/**/*.wav
assets/recordings/**/*.mp3
assets/recordings/**/*.m4a
assets/recordings/**/*.aif
assets/recordings/**/*.aiff
assets/recordings/**/*.flac
assets/recordings/**/*.aac
assets/recordings/**/*.ogg

# RAVE models/exports (large, research material stored elsewhere)
assets/rave/
# demo archive and training weights (large; release weights are published separately)
assets/demos/_archive/
assets/demos/*.pt
# user timbre library (generated at runtime)
assets/user_tones/

# large training/evaluation outputs (models, dataset slices, rendered audio) are not committed
/checkpoints/
!checkpoints/MODEL_CARDS.md
!checkpoints/eval/eval_results.json
data/
!docs/report/data/
tmp/
assets/glass/
assets/ear_tests/
assets/user_styles/
assets/user_tones/


# rebuildable evaluation caches
results/atlas/snaps/

# LaTeX build outputs
docs/ismir_lbd_2026/*.aux
docs/ismir_lbd_2026/*.log
docs/ismir_lbd_2026/*.blg
docs/ismir_lbd_2026/missfont.log

# Poster iterations, large PNGs
artifacts/

# DDSP bake outputs (runtime-generated)
assets/user_ddsp/

# Branding assets (large images, managed outside git)
assets/branding/

# Demo AB test wav directories
assets/demos/ab_*/


# default timbre snapshot: both the app and the tests depend on it, so it must ship with the repo (134 KB)
!assets/snapshots/synth_pad.npz

# runtime state (per machine, never committed)
assets/session.json
assets/takes/

# legacy front-end: local build output and env never tracked
legacy/companion/dist/
legacy/companion/.env
legacy/companion/node_modules/
legacy/companion_dist/
